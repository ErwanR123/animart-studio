# The studio's keys (README > Setup, step 5). Read by scripts/voice-gemini.py and scripts/guide-generate.py,
# never printed. Copy this file to .env (git-ignored) and fill it.
GOOGLE_API_KEY=                     # https://aistudio.google.com/apikey — Gemini TTS (the Guide's voice) and Gemini image (new Guide poses)
GUIDE_VOICE_ID_GEMINI=              # the Guide's voice: ask Erwan, so every video has the same voice
# TTS_MODEL_GEMINI_PREMIUM=gemini-3.8-flash-tts
