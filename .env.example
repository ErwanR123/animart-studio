# The studio's keys (copy them from the app's .env). Read by scripts/voiceover-gemini.py and scripts/sfx.mjs, never printed.
GOOGLE_API_KEY=                     # Gemini TTS: the Guide's voice
GUIDE_VOICE_ID_GEMINI=              # same voice as the app (prebuilt name like Charon, or a Voice Design id voice_…)
# TTS_MODEL_GEMINI_PREMIUM=gemini-3.8-flash-tts
ELEVENLABS_API_KEY=                 # sound effects only (scripts/sfx.mjs)
