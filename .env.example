# The studio's keys (copy them from the app's .env). Read by scripts/voice-gemini.py and
# scripts/guide-generate.py, never printed.
GOOGLE_API_KEY=                     # Gemini TTS (the Guide's voice) and Gemini image (new Guide poses)
GUIDE_VOICE_ID_GEMINI=              # same voice as the app (prebuilt name like Charon, or a Voice Design id voice_…)
